
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Burnitortrader Auto Bot</title>
  <style>
    body { font-family: Arial, sans-serif; text-align: center; background: #f4f6f9; padding: 30px; }
    .card { background: white; max-width: 450px; margin: auto; padding: 25px; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
    button { background: #ff444f; color: white; border: none; padding: 12px 20px; border-radius: 6px; font-weight: bold; cursor: pointer; margin: 10px; }
    button:hover { background: #d9363e; }
    button:disabled { background: #cccccc; cursor: not-allowed; }
    .status { margin-top: 15px; font-weight: bold; color: #333; }
  </style>
</head>
<body>

  <div class="card">
    <h2>Burnitortrader Auto Bot</h2>
    <p>Connect your Deriv account to start automated trading.</p>

    <!-- Login Button -->
    <button id="loginBtn">Log in with Deriv</button>

    <hr style="margin: 20px 0;">

    <!-- Bot Controls -->
    <button id="startBotBtn" disabled>Start Bot</button>
    <button id="stopBotBtn" disabled>Stop Bot</button>

    <div class="status" id="statusText">Status: Disconnected</div>
  </div>

  <script>
    // Your actual App ID from Deriv Developer Portal
    const APP_ID = '34Lu9mGUc3CNrw2nTelD0'; 
    const AFFILIATE_TOKEN = '89SKPGDAK3ZX'; // Your affiliate token

    const loginBtn = document.getElementById('loginBtn');
    const startBotBtn = document.getElementById('startBotBtn');
    const stopBotBtn = document.getElementById('stopBotBtn');
    const statusText = document.getElementById('statusText');

    let ws = null;
    let botRunning = false;
    let botInterval = null;

    // 1. Redirect user to Deriv login page
    loginBtn.onclick = () => {
      const redirectUrl = encodeURIComponent(window.location.origin);
      window.location.href = `https://oauth.deriv.com/oauth2/authorize?app_id=${APP_ID}&affiliate_token=${AFFILIATE_TOKEN}&redirect_uri=${redirectUrl}`;
    };

    // 2. Capture token from URL after redirect
    const urlParams = new URLSearchParams(window.location.search);
    const token = urlParams.get('token1');

    if (token) {
      statusText.innerText = "Status: Verifying account...";
      connectWebSocket(token);
    }

    // 3. Connect to Deriv WebSocket
    function connectWebSocket(authToken) {
      ws = new WebSocket(`wss://ws.derivws.com/websockets/v3?app_id=${APP_ID}`);

      ws.onopen = () => {
        ws.send(JSON.stringify({ authorize: authToken }));
      };

      ws.onmessage = (event) => {
        const response = JSON.parse(event.data);

        if (response.msg_type === 'authorize') {
          statusText.innerText = `Connected as: ${response.authorize.email}`;
          startBotBtn.disabled = false;
        }

        if (response.msg_type === 'buy') {
          console.log("Trade executed!", response);
          statusText.innerText = `Trade Executed! Contract ID: ${response.buy.contract_id}`;
        }
      };
    }

    // 4. Bot Execution Logic
    startBotBtn.onclick = () => {
      botRunning = true;
      startBotBtn.disabled = true;
      stopBotBtn.disabled = false;
      statusText.innerText = "Status: Bot is running...";

      botInterval = setInterval(() => {
        if (botRunning && ws) {
          executeTrade();
        }
      }, 5000);
    };

    stopBotBtn.onclick = () => {
      botRunning = false;
      clearInterval(botInterval);
      startBotBtn.disabled = false;
      stopBotBtn.disabled = true;
      statusText.innerText = "Status: Bot stopped";
    };

    function executeTrade() {
      ws.send(JSON.stringify({
        buy: 1,
        price: 1,
        parameters: {
          amount: 1,
          basis: 'stake',
          contract_type: 'DIGITEVEN',
          currency: 'USD',
          duration: 1,
          duration_unit: 't',
          symbol: 'R_100'
        }
      }));
    }
  </script>

</body>
</html>

          
